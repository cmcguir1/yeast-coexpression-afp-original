namespace: biological_process
def: "The directed movement of azoles, heterocyclic compounds found in many biologically important substances, into, out of, within or between cells." [GOC:go_curators, http://cancerweb.ncl.ac.uk/]
is_a: GO:0015893 ! drug transport

[Term]
id: GO:0045118
