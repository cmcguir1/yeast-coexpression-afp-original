[Term]
id: GO:0021999
name: neural plate anterioposterior pattern formation
namespace: biological_process
def: "The process that regulates the coordinated growth and differentiation that establishes the non-random anterior-posterior spatial arrangement of the neural plate." [GOC:cls, GOC:dgh, GOC:dph, GOC:jic, GOC:mtg_15jun06]
