[Term]
id: GO:0009530
name: primary cell wall
namespace: cellular_component
def: "A plant cell wall that is still able to expand, permitting cell growth. Primary cell walls contain more pectin than secondary walls and no lignin is present." [GOC:jic, http://cancerweb.ncl.ac.uk]
is_a: GO:0009505 ! cellulose and pectin-containing cell wall
is_a: GO:0048196 ! middle lamella-containing extracellular matrix

[Term]
id: GO:0009531
name: secondary cell wall
namespace: cellular_component
def: "A plant cell wall that is no longer able to expand and so does not permit growth. Secondary cell walls contain less pectin that primary cell walls. The secondary cell is mostly composed of cellulose and is strengthened with lignin." [GOC:jic, http://cancerweb.ncl.ac.uk]
is_a: GO:0009505 ! cellulose and pectin-containing cell wall
is_a: GO:0048196 ! middle lamella-containing extracellular matrix

