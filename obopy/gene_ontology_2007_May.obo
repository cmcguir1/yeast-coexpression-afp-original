is_a: GO:0050768 ! negative regulation of neurogenesis
relationship: part_of GO:0007405 ! neuroblast proliferation

[Term]
id: GO:0007407
name: neuroblast activation
namespace: biological_process
def: "A change in the morphology or behavior of a neuroblast resulting from exposure to an activating factor such as a cellular or soluble ligand." [GOC:go_curators]
is_a: GO:0001775 ! cell activation
relationship: part_of GO:0048699 ! generation of neurons

[Term]
id: GO:0007409
name: axonogenesis
namespace: biological_process
alt_id: GO:0007410
