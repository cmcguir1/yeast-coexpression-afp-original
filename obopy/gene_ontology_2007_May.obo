namespace: biological_process
def: "Progression through metaphase of meiosis II; analogous to mitotic metaphase." [GOC:mah]
is_a: GO:0051323 ! metaphase
relationship: part_of GO:0007135 ! meiosis II

[Term]
id: GO:0007138
