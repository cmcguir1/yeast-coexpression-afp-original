namespace: molecular_function
def: "Enables the directed movement of acidic amino acids, amino acids with a pH below 7, into, out of, within or between cells." [GOC:ai]
subset: gosubset_prok
is_a: GO:0015171 ! amino acid transporter activity

[Term]
id: GO:0015173
name: aromatic amino acid transporter activity
