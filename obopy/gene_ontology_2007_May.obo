subset: gosubset_prok
exact_synonym: "dimeric RNase P complex" []
narrow_synonym: "ribonuclease P complex (sensu Bacteria)" []
narrow_synonym: "RNase P complex (sensu Bacteria)" []
is_a: GO:0030677 ! ribonuclease P complex

[Term]
