[Term]
id: GO:0048850
name: hypophysis morphogenesis
namespace: biological_process
def: "The process by which the anatomical structures of the hypophysis are generated and organized. Morphogenesis pertains to the creation of form. The pituitary gland is an endocrine gland that secretes hormones that regulate many other glands." [GOC:cls, GOC:dgh, GOC:dph, GOC:jic]
exact_synonym: "hypophysis morphogenesis" []
exact_synonym: "pituitary gland morphogenesis" []
