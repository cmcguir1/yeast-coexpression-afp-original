is_a: GO:0042592 ! homeostatic process

[Term]
id: GO:0048872
name: homeostasis of number of cells
namespace: biological_process
def: "The biological processes involved in the maintenance of the equilibrium of cell number within a population of cells." [GOC:isa_complete]
