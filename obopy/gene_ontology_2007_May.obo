is_a: GO:0045937 ! positive regulation of phosphate metabolic process

[Term]
id: GO:0035307
name: positive regulation of protein amino acid dephosphorylation
namespace: biological_process
def: "Any process that activates or increases the frequency, rate or extent of removal of phosphoric groups from a protein." [GOC:bf]
subset: gosubset_prok
exact_synonym: "up regulation of protein amino acid dephosphorylation" []
exact_synonym: "up-regulation of protein amino acid dephosphorylation" []
exact_synonym: "upregulation of protein amino acid dephosphorylation" []
narrow_synonym: "activation of protein amino acid dephosphorylation" []
