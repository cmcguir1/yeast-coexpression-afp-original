exact_synonym: "vacuolar lumen (sensu Magnoliophyta)" []
is_a: GO:0005775 ! vacuolar lumen
relationship: part_of GO:0000325 ! vacuole, cell cycle independent morphology

[Term]
id: GO:0000331
name: contractile vacuole
namespace: cellular_component
def: "A specialized vacuole of eukaryotic cells, especially Protozoa, that fills with water from the cytoplasm and then discharges this externally by the opening of contractile vacuole pores. Its function is probably osmoregulatory." [GOC:jl, http://cancerweb.ncl.ac.uk/, PMID:10503189]
is_a: GO:0005773 ! vacuole

[Term]
