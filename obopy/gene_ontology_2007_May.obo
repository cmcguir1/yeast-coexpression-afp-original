[Term]
id: GO:0016561
name: protein import into peroxisome matrix, translocation
namespace: biological_process
def: "The process by which proteins are moved across the peroxisomal membrane into the matrix. It is likely that the peroxisome targeting sequence receptor remains associated with cargo proteins during translocation." [PMID:11687502]
related_synonym: "peroxisome receptor translocation" []
exact_synonym: "peroxisome matrix protein import, translocation" []
exact_synonym: "protein translocation during peroxisome matrix protein import" []
