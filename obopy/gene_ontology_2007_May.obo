[Term]
id: GO:0016056
name: rhodopsin mediated signaling
namespace: biological_process
def: "The series of molecular signals generated as a consequence of excitation of rhodopsin by a photon." [GOC:hb]
exact_synonym: "rhodopsin mediated signalling" []
is_a: GO:0007165 ! signal transduction
relationship: part_of GO:0009586 ! rhodopsin mediated phototransduction

[Term]
id: GO:0016057
name: changes in polarization state of photoreceptor cell membrane
namespace: biological_process
def: "Hyperpolarization (vertebrates) or depolarization (invertebrates) of the photoreceptor cell membrane via closing/opening of cation specific channels as a result of signals generated by rhodopsin activation by a photon." [GOC:hb]
is_a: GO:0042391 ! regulation of membrane potential
relationship: part_of GO:0016056 ! rhodopsin mediated signaling

[Term]
id: GO:0016058
name: maintenance of rhodopsin mediated signaling
namespace: biological_process
