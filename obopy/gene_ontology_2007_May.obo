[Term]
id: GO:0009521
name: photosystem
namespace: cellular_component
def: "One of the photochemical systems containing photosynthetic and accessory pigments and electron carriers that operate in sequence to perform the two light reactions of photosynthesis." [ISBN:0140514031]
