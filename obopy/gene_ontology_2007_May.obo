exact_synonym: "mechanochemical coupling" []
is_obsolete: true

[Term]
id: GO:0006944
name: membrane fusion
namespace: biological_process
def: "The joining of two lipid bilayers to form a single membrane." [GOC:mah]
subset: goslim_goa
related_synonym: "vesicle-fusing ATPase activity" []
is_a: GO:0016044 ! membrane organization and biogenesis

[Term]
id: GO:0006945
name: nuclear fusion during karyogamy
namespace: biological_process
