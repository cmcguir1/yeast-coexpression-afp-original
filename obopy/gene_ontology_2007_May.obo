name: glucuronate transport
namespace: biological_process
def: "The directed movement of glucuronate into, out of, within or between cells." [GOC:krc]
is_a: GO:0015736 ! hexuronate transport

[Term]
id: GO:0015739
name: sialic acid transport
namespace: biological_process
def: "The directed movement of sialic acid into, out of, within or between cells." [GOC:krc]
subset: gosubset_prok
is_a: GO:0015718 ! monocarboxylic acid transport

[Term]
id: GO:0015740
