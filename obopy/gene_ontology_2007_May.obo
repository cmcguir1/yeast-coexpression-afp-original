[Term]
id: GO:0021799
name: cerebral cortex radially oriented migration
namespace: biological_process
def: "The migration of cells in the developing cerebral cortex in which cells move from the ventricular and/or subventricular zone toward the surface of the brain." [GOC:cls, GOC:dgh, GOC:dph, GOC:jic, GOC:mtg_15jun06, PMID:12626695]
