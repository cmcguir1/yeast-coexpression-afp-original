[Term]
id: GO:0007310
name: oocyte dorsal/ventral axis determination
namespace: biological_process
alt_id: GO:0008072
def: "The establishment, maintenance and elaboration of the dorsal/ventral axis of the oocyte." [ISBN:0879694238]
