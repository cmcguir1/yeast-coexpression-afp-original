[Term]
id: GO:0030180
name: solute:solute exchange
namespace: biological_process
def: "OBSOLETE. Exchange diffusion of two solutes between the inside and outside of a cell or subcellular compartment, in which movement of one solute down a concentration gradient drives movement of the other solute in the opposite direction." [GOC:mah]
comment: This term was made obsolete because it represents a molecular function. To update annotations, use biological_process term 'transport ; GO:0006810' and molecular_function term 'solute:solute antiporter activity ; GO:0015300'.
is_obsolete: true

[Term]
id: GO:0030181
name: sodium:calcium exchange
namespace: biological_process
