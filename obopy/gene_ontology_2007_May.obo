[Term]
id: GO:0032279
name: asymmetric synapse
namespace: cellular_component
def: "A type of synapse occurring between an axon and a dendritic spine or dendritic shaft. Asymmetric synapses, the most abundant synapse type in the central nervous system, involve axons that contain predominantly spherical vesicles and contain a thickened postsynaptic density." [GOC:dgh, GOC:ef]
is_a: GO:0045202 ! synapse

[Term]
id: GO:0032280
name: symmetric synapse
namespace: cellular_component
def: "A type of synapse occurring primarily on dendrite shafts and neuronal cell bodies. Symmetric synapses involve axons containing clusters of predominantly flattened or elongated vesicles and do not contain a prominent postsynaptic density." [GOC:dgh, GOC:ef]
is_a: GO:0045202 ! synapse

