related_synonym: "etiolation" []
is_a: GO:0009646 ! response to absence of light
is_a: GO:0009791 ! post-embryonic development

[Term]
id: GO:0009648
name: photoperiodism
namespace: biological_process
def: "A change in state or activity of the organism (in terms of movement, secretion, enzyme production, gene expression, etc.) as a result of detection of, or exposure to, a period of light or dark of a given length, measured relative to a particular duration known as the 'critical daylength'. The critical daylength varies between species." [GOC:jic, GOC:pj, ISBN:0582015952, ISBN:0697037754, ISBN:070940886]
exact_synonym: "response to daylength" []
exact_synonym: "response to nightlength" []
exact_synonym: "response to photoperiod" []
is_a: GO:0009416 ! response to light stimulus

[Term]
