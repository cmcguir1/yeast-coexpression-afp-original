[Term]
id: GO:0012511
name: monolayer-surrounded lipid storage body
namespace: cellular_component
alt_id: GO:0009520
def: "A subcellular organelle of plant cells surrounded by 'half-unit' or a monolayer membrane instead of the more usual bilayer. A droplet of triacylglycerol surrounded by a monolayer of phospholipids, interacting with the triacylglycerols and the hydrophilic head groups facing the cytosol, and containing major protein components called oleosins." [GOC:mtg_sensu, ISBN:0943088372]
exact_synonym: "lipid storage body (sensu Viridiplantae)" []
exact_synonym: "oil body" []
exact_synonym: "oleosome" []
