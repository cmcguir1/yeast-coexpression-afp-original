namespace: cellular_component
def: "The large subunit of a ribosome; has a sedimentation coefficient of 60S. As in, but not restricted to, the eukaryotes (Eukaryota, ncbi_taxonomy_id:2759)." [GOC:jic]
narrow_synonym: "60S ribosomal subunit" []
broad_synonym: "cytosolic large ribosomal subunit" []
is_a: GO:0015934 ! large ribosomal subunit
