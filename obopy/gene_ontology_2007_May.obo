[Term]
id: GO:0016547
name: RNA editing
namespace: biological_process
def: "The insertion, deletion or substitution of nucleotides within nascent RNA transcripts to produce RNA molecules with sequences that differ from those coded genetically." [ISBN:0198506732 "Oxford Dictionary of Biochemistry and Molecular Biology"]
subset: gosubset_prok
is_a: GO:0009451 ! RNA modification

[Term]
id: GO:0016548
name: rRNA editing
namespace: biological_process
