[Term]
id: GO:0002333
name: transitional one stage B cell differentiation
namespace: biological_process
def: "The process whereby immature B cells from the bone marrow acquire the specialized features of T1 stage B cells in the spleen. T1 stage B cells do not express either CD23 or CD21." [GOC:jal, ISBN:0781735149 "Fundamental Immunology"]
exact_synonym: "T1 stage B cell differentiation" []
exact_synonym: "transitional one stage B lymphocyte differentiation" []
exact_synonym: "transitional one stage B-cell differentiation" []
