is_a: GO:0016791 ! phosphoric monoester hydrolase activity

[Term]
id: GO:0010348
name: lithium:hydrogen antiporter activity
namespace: molecular_function
def: "Catalysis of the reaction: Li+(in) + H+(out) = Li+(out) + H+(in)." [PMID:17270011]
is_a: GO:0005451 ! monovalent cation:proton antiporter activity

[Term]
