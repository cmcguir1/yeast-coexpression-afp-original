is_a: GO:0016547 ! RNA editing

[Term]
id: GO:0016549
name: tRNA editing
namespace: biological_process
def: "The chemical modification of nucleotides within the primary transcript of transfer RNA (tRNA), necessary to form a mature tRNA." [ISBN:0321000382]
subset: gosubset_prok
is_a: GO:0006400 ! tRNA modification
is_a: GO:0008033 ! tRNA processing
is_a: GO:0016547 ! RNA editing

[Term]
id: GO:0016550
name: insertion or deletion editing
namespace: biological_process
def: "The insertion into or deletion from an RNA molecule of nucleotide residues not encoded in DNA; takes place during or after transcription." [PMID:11092837]
subset: gosubset_prok
exact_synonym: "insertion/deletion editing" []
is_a: GO:0016547 ! RNA editing

[Term]
id: GO:0016551
name: posttranscriptional insertion or deletion editing
namespace: biological_process
def: "The insertion into or deletion from an RNA molecule of nucleotide residues not encoded in DNA; takes place after transcription." [PMID:11092837]
subset: gosubset_prok
exact_synonym: "posttranscriptional insertion/deletion editing" []
is_a: GO:0016550 ! insertion or deletion editing

[Term]
id: GO:0016552
name: cotranscriptional insertion or deletion editing
namespace: biological_process
def: "The insertion into or deletion from an RNA molecule of nucleotide residues not encoded in DNA; takes place during transcription." [PMID:11092837]
subset: gosubset_prok
exact_synonym: "cotranscriptional insertion/deletion editing" []
is_a: GO:0016550 ! insertion or deletion editing

[Term]
id: GO:0016553
name: base conversion or substitution editing
namespace: biological_process
def: "Any base modification or substitution events that result in alterations in the coding potential or structural properties of RNAs as a result of changes in the base-pairing properties of the modified ribonucleoside(s)." [PMID:11092837]
subset: gosubset_prok
exact_synonym: "base conversion/substitution editing" []
is_a: GO:0016547 ! RNA editing

[Term]
id: GO:0016554
name: cytidine to uridine editing
namespace: biological_process
def: "The conversion of a cytosine residue to uridine in an RNA molecule by deamination." [PMID:11092837]
subset: gosubset_prok
xref_analog: Reactome:72200
is_a: GO:0016553 ! base conversion or substitution editing

[Term]
id: GO:0016555
name: uridine to cytidine editing
namespace: biological_process
def: "The conversion of a uridine residue to cytosine in an RNA molecule by amination." [PMID:11092837]
subset: gosubset_prok
is_a: GO:0016553 ! base conversion or substitution editing

[Term]
id: GO:0016556
