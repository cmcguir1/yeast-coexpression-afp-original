relationship: part_of GO:0016056 ! rhodopsin mediated signaling

[Term]
id: GO:0016059
name: deactivation of rhodopsin mediated signaling
namespace: biological_process
def: "The process of restoring the photoreceptor cell to its unexcited state after termination of the stimulus (photon)." [PMID:8316831]
exact_synonym: "deactivation of rhodopsin mediated signalling" []
is_a: GO:0008277 ! regulation of G-protein coupled receptor protein signaling pathway
relationship: part_of GO:0009586 ! rhodopsin mediated phototransduction

[Term]
