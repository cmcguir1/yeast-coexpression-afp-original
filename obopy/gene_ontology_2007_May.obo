def: "The process which controls the timing of the type of sexual cycle seen in female mammals." [GOC:dph]
exact_synonym: "generation of estrus cycle rhythm" []
exact_synonym: "generation of oestrus cycle rhythm" []
is_a: GO:0022602 ! menstrual cycle process

[Term]
id: GO:0060113
name: inner ear receptor cell differenatioan
namespace: biological_process
def: "The process whereby relatively unspecialized cells,  acquire specialized structural and/or functional features of inner ear receptor cells. Inner ear receptor cells are mechanorecptors found in the inner ear responsible for transducing signals involved in balance and sensory perception of sound." [GOC:dph]
related_synonym: "<new synonym>" []
is_a: GO:0042490 ! mechanoreceptor differentiation
relationship: part_of GO:0048839 ! inner ear development

[Term]
id: GO:0060114
name: vestibular receptor cell differentiation
namespace: biological_process
def: "The process whereby a relatively unspecialized cell acquires specialized features of a vestibular hair cell." [GOC:dph]
related_synonym: "<new synonym>" []
exact_synonym: "vestibular hair cell" []
is_a: GO:0060113 ! inner ear receptor cell differenatioan

