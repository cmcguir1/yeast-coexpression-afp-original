[Term]
id: GO:0007400
name: neuroblast fate determination
namespace: biological_process
alt_id: GO:0007408
def: "Process by which a cell becomes capable of differentiating autonomously into a neuroblast cell regardless of its environment; upon determination, the cell fate cannot be reversed." [GOC:go_curators]
exact_synonym: "neuroblast cell fate determination" []
exact_synonym: "neuroblast identity determination" []
