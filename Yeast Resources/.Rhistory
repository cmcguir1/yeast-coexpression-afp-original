#Function that takes in a dataset and convex hulls its Precision Column, and sorts by confidence
convexHull <- function(data,column) {
#Sorts data by confidence
data <- data[order(data[,2],decreasing = FALSE),]
for(i in length(data[,"Recall"]):2) {
if(data[i,"Precision"] < data[i-1,"Precision"]) data[i,"Precision"] <- data[i-1,"Precision"]
}
for(i in 1:(length(data[,"Recall"])-1)) {
if(data[i,"Precision"] > data[i+1,"Precision"]) data[i+1,"Precision"] <- data[i,"Precision"]
}
return(data)
}
plotEnsemblePR <- function(nnFile) {
pixie <- convexHull(read.csv("C:\\Users\\colem\\SummerResearch2022\\Yeast Resources\\ConfusionMatrixPixie.csv"),"Confidence")
mefit <- convexHull(read.csv("C:\\Users\\colem\\SummerResearch2022\\Yeast Resources\\ConfusionMatrixMefit.csv"),"Confidence")
spell <- convexHull(read.csv("C:\\Users\\colem\\SummerResearch2022\\Yeast Resources\\ConfusionMatrixSpell.csv"),"Confidence")
nn <- convexHull(read.csv(nnFile),"Score")
plot(pixie[,"Recall"],pixie[,"Precision"],type="l")
lines(mefit[,"Recall"],mefit[,"Precision"])
lines(spell[,"Recall"],spell[,"Precision"])
lines(nn[,"Precision"],nn[,"Precision"])
}
file <- file.choose()
plotEnsemblePR(nnFile=file)
