#plot(den4,type="l",lwd=w)
polygon(den4,col=purple,border=borderpurp,lwd=w)
legend("topright",c("Fold 1", "Fold 2","Fold 3","Fold 4"),lty=1,lwd=4,seg.len = 4, col = c(borderlb,borderlg,borderpk,borderpurp))
}
