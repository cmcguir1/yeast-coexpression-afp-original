heatmap(as.matrix(heatData),Colv = NA,Rowv = NA,col=cols2,main=graphName,ylab=10)
legend("right",c("0.0","","","","","0.5","","","","","1.0"),col =colorRampPalette(cols2)(11),pch=15,pt.cex = 3,title="Pearson Correlation")
}
