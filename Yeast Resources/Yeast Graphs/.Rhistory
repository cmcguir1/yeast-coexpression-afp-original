heatmap(as.matrix(heatData),Colv = NA,Rowv = NA,col=cols2,main=graphName)
legend("right",c("0.0","","","","","0.5","","","","","1.0"),col =colorRampPalette(cols2)(11),pch=15,pt.cex = 3,title="Pearson Correlation")
}
file <- file.choose()
graphName <- "Brem 24 Positives"
fileName <- "Brem_24_Pos_HM.pdf"
pdf(fileName,width=12,height=9)
plotHeatmap(file=file,graphName=graphName)
dev.off()
?heatmap
