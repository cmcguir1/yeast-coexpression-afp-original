#Function that takes in a dataset and convex hulls its Precision Column, and sorts by confidence
convexHull <- function(data,column,dec) {
#Sorts data by confidence
data <- data[order(data[,column],decreasing =dec),]
for(i in length(data[,"Recall"]):2) {
if(data[i,"Precision"] > data[i-1,"Precision"]) data[i-1,"Precision"] <- data[i,"Precision"]
}
#for(i in 1:(length(data[,"Recall"])-1)) {
#  if(data[i,"Precision"] > data[i+1,"Precision"]) data[i+1,"Precision"] <- data[i,"Precision"]
#}
return(data)
}
getAUC <- function(data) {
pre <- grep("Precision",colnames(data))
recall <- grep("Recall",colnames(data))
splice <- data[,pre:recall]
uSplice <- unique(splice)
decimalPlaces <- 3
return(format(round(mean(uSplice[,1]),decimalPlaces) , nsmall=decimalPlaces))
}
plotEnsemblePR <- function(nnFile,graphName) {
colorsList <- c("#FC0303","#14A63B","#5D87F0","#7713BA","#FAEF16","#E09704")
width <- 4
pixie <- convexHull(read.csv("C:\\Users\\colem\\SummerResearch2022\\Yeast Resources\\ConfusionMatrixPixie.csv"),"Confidence",dec=TRUE)
mefit <- convexHull(read.csv("C:\\Users\\colem\\SummerResearch2022\\Yeast Resources\\ConfusionMatrixMefit.csv"),"Confidence",dec=TRUE)
spell <- convexHull(read.csv("C:\\Users\\colem\\SummerResearch2022\\Yeast Resources\\ConfusionMatrixSpell.csv"),"Rank",dec=FALSE)
nn <- convexHull(read.csv(nnFile),"Score",dec=TRUE)
plot(pixie[,"Recall"],pixie[,"Precision"],type="l",col=colorsList[1],lwd=width,log='x',ylim=c(0,1),xlab="Recall",ylab="Precision",main=graphName)
lines(mefit[,"Recall"],mefit[,"Precision"],col=colorsList[2],lwd=width)
lines(spell[,"Recall"],spell[,"Precision"],col=colorsList[3],lwd=width)
lines(nn[,"Recall"],nn[,"Precision"],col=colorsList[4],lwd=width)
legendLabels <- c()
legendLabels <- append(legendLabels,paste("bioPIXIE (AUC =",getAUC(pixie),")"))
legendLabels <- append(legendLabels,paste("MEFIT (AUC =",getAUC(mefit),")"))
legendLabels <- append(legendLabels,paste("SPELL (AUC =",getAUC(spell),")"))
legendLabels <- append(legendLabels,paste("Neural Net (AUC =",getAUC(nn),")"))
legend("bottomleft",legendLabels,lty=1,lwd=width, seg.len = 4,col = colorsList)
}
file <- file.choose()
graphName <- "Ensmeble Comparison 113x20x1"
pdf("EnsembleComparision_First_PR.pdf",width=8,height=6)
plotEnsemblePR(nnFile=file,graphName=graphName)
dev.off()
