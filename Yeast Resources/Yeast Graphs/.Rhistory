file <- file.choose()
heatData <- read.csv(file,sep=",",row.names = 1)
colors <- colorRampPalette(brewer.pal(9,"YlOrRd"))(100)
cols <- c(colorRampPalette(c("#F7FBFF","#CBDEF0"))(20),colorRampPalette(c("#CBDEF0","#08306B"))(120))
cols2 <-c(colorRampPalette(c("#FFFFFF",colors[30]))(60),colorRampPalette(colors[30:100])(140))
heatmap(as.matrix(heatData),Colv = NA,Rowv = NA,col=cols2)
legend("right",legend = c("0.0","","","","","","","","","1.0"),
fill=colorRampPalette(cols2)(10),pt.cex = 2)
#heatmap(as.matrix(heatData))
