graphName <- "Pairwise Syntheitc Small 36-264: 5x1 Validation"
pdf("Pair_Small-36-264_5x1_Val_ROC.pdf",width=6,height=6)
plotROC(files=files,colorsList=colorsList,graphName=graphName)
dev.off()
?bars
