#Function that takes in a dataset and convex hulls its Precision Column, and sorts by confidence
convexHull <- function(data,column,dec) {
#Sorts data by confidence
data <- data[order(data[,column],decreasing =dec),]
for(i in length(data[,"Recall"]):2) {
if(data[i,"Precision"] > data[i-1,"Precision"]) data[i-1,"Precision"] <- data[i,"Precision"]
}
#for(i in 1:(length(data[,"Recall"])-1)) {
#  if(data[i,"Precision"] > data[i+1,"Precision"]) data[i+1,"Precision"] <- data[i,"Precision"]
#}
return(data)
}
getAUC <- function(data) {
pre <- grep("Precision",colnames(data))
recall <- grep("Recall",colnames(data))
splice <- data[,pre:recall]
uSplice <- unique(splice)
decimalPlaces <- 3
return(format(round(mean(uSplice[,1]),decimalPlaces) , nsmall=decimalPlaces))
}
