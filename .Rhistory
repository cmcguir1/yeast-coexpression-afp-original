source("https://raw.githubusercontent.com/legalLab/protocols-scripts/master/scripts/sir_functions.R")
#Question 1 - 4
N <- 100
t <- 500
bLst <- c(1e-3,2e-3,3e-3,4e-3,5e-3)
a <- 1e-1
for(b in bLst) {
model <- sir_det(N,t,b,a)
plot_sir(model)
#print(model)
#print(model[model$I == max(model$I),])
#print(tail(model))
}
