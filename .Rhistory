fit<-lm(qsec~hp,data = mtcars)
summary(fit)
CI<-predict(fit,interval="confidence", level = 0.95)
CI
PI<-predict(fit,interval="prediction") #we used this to put the PI on the scatterplot
# To make estimates/predictions with new data it helps to create a data frame
# We only need to include the variables used by the model
newdata<-data.frame(hp=c(100,200,300))
CI2<-predict(fit,newdata=newdata,interval="confidence")
CI2
PI2<-predict(fit,newdata=newdata,interval="prediction")
PI2
# To make estimates/predictions with new data it helps to create a data frame
# We only need to include the variables used by the model
newdata<-data.frame(hp=c(400))
CI2<-predict(fit,newdata=newdata,interval="confidence")
CI2
PI2<-predict(fit,newdata=newdata,interval="prediction")
